GITHUB_CLIENT_ID="replace-with-your-oauth-app-client-id"
PUBLIC_ORIGIN="auto"
GITHUB_CLIENT_SECRET="set-in-.dev.vars-only"
COOKIE_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
EXPORT_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
GITHUB_EXPORT_TOKEN="optional-fine-grained-token-not-login-token"
SEMANTIC_SEARCH_ENABLED="false"
