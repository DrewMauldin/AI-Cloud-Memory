# Never commit plaintext memory exports or import staging data.
exports/**
imports/**

# Encrypted exports and non-sensitive receipts are allowed explicitly.
!exports/**/
!exports/.gitkeep
!exports/**/*.enc.json
!exports/**/*.receipt.json
!imports/**/
!imports/.gitkeep
