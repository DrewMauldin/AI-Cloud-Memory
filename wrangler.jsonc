{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-cloud-memory",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "APP_ENV": "production",
    "ALLOWED_GITHUB_USER_ID": "SET_YOUR_NUMERIC_GITHUB_ID",
    "ALLOWED_GITHUB_LOGIN": "your-github-login",
    "GITHUB_EXPORT_REPOSITORY": "your-github-login/ai-cloud-memory-backups",
    "NATIVE_AUTOMATION_ENABLED": "false",
    "PUBLIC_ORIGIN": "auto",
    "SEMANTIC_SEARCH_ENABLED": "false"
  },
  "triggers": { "crons": ["11 * * * *", "23 2 * * *", "37 3 * * SUN"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-cloud-memory", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vectorize": [{ "binding": "MEMORY_INDEX", "index_name": "ai-cloud-memory" }],
  "ai": { "binding": "AI" },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*", "/mcp", "/login", "/authorize", "/authorize/*", "/bridge/*",
      "/callback", "/logout", "/oauth/*", "/.well-known/*"
    ]
  }
}
